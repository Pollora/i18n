{
    "name": "pollora/i18n",
    "description": "Translatable labels for WordPress code that declares them as constants, and the tooling to extract and compile them. Runs with or without Laravel.",
    "type": "library",
    "keywords": [
        "gettext",
        "i18n",
        "pollora",
        "translation",
        "wordpress"
    ],
    "homepage": "https://pollora.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "Amphibee",
            "email": "contact@amphibee.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Pollora/i18n/issues",
        "source": "https://github.com/Pollora/i18n"
    },
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "pestphp/pest": "^3.8.2",
        "pollora/harness": "^0.1.23"
    },
    "suggest": {
        "nikic/php-parser": "Reads PHP source files to extract their strings (Tooling only, never loaded by a web request)",
        "symfony/console": "Runs the extraction commands (Tooling only, never loaded by a web request)",
        "illuminate/view": "Compiles Blade views to extract their strings (Tooling only)"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\I18n\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\I18n\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test",
        "qa": "@php vendor/bin/pollora-qa check",
        "qa:fast": "@php vendor/bin/pollora-qa check --fast"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
